# Autenticación (sesiones por dispositivo)
# Genera las claves con los comandos de openssl del README ("Configurar variables de entorno")
# Access token: JWT EdDSA (Ed25519). PEM en una línea con \n escapados.
JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----'
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----'
JWT_ISSUER=lunance
JWT_AUDIENCE=lunance-api
ACCESS_TOKEN_EXPIRE_MINUTES=10
# Deriva el sucesor de cada refresh token al rotarlo (mínimo 32 caracteres).
# Cambiarla obliga a todos los dispositivos a volver a iniciar sesión.
REFRESH_ROTATION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Repetir un refresh ya canjeado dentro de esta ventana no revoca la sesión.
REFRESH_REUSE_GRACE_SECONDS=30
# Duración de las sesiones (días): inactividad máxima y tope absoluto desde el login.
SESSION_WEB_IDLE_DAYS=1
SESSION_WEB_ABSOLUTE_DAYS=7
SESSION_MOBILE_IDLE_DAYS=30
SESSION_MOBILE_ABSOLUTE_DAYS=90

# Refresh token cookie (httpOnly)
# COOKIE_SECURE must be False for local HTTP dev — browsers drop Secure
# cookies on non-HTTPS origins even on localhost. Use True in PROD/staging.
COOKIE_DOMAIN=
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
COOKIE_HTTPONLY=True

# Correo (verificación de correo y recuperación de contraseña)
# EMAIL_BACKEND: resend (producción), smtp (Mailpit en local) o memory (tests).
# Vacío = resend en PROD, smtp en DEV, memory en TEST. En PROD solo se acepta resend
# con RESEND_API_KEY y un EMAIL_LINK_BASE_URL https (la app no arranca si falta).
EMAIL_BACKEND=
# Remitente. En producción, un dominio verificado en Resend (SPF, DKIM, DMARC).
EMAIL_FROM="Lunance <no-reply@lunance.app>"
RESEND_API_KEY=CHANGE_ME
# SMTP: por defecto el Mailpit local (UI en http://localhost:8025). En docker-compose,
# SMTP_HOST se sobrescribe para apuntar al servicio `mailpit` (perfil dev).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=False
# Base de los enlaces de los correos: la web que abre /verify-email y /reset-password.
# Vacío = FRONTEND_URL.
EMAIL_LINK_BASE_URL=
# Vigencia del enlace de verificación (horas), del registro sin confirmar (días) y del
# enlace de recuperación de contraseña (minutos).
EMAIL_VERIFICATION_TTL_HOURS=24
PENDING_SIGNUP_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Iniciar sesión con Google y Apple (guía en README, "Google y Apple")
# Sin client IDs el proveedor queda apagado: /auth/google o /auth/apple responden 503
# AUTH_PROVIDER_NOT_CONFIGURED. Listas separadas por comas, sin espacios ni comillas.
# Google: client IDs OAuth de la web, iOS y Android (Google Cloud Console > Credenciales).
GOOGLE_CLIENT_IDS=
# Apple: bundle ID de la app de iOS y Services ID de la web (Apple Developer > Identifiers).
APPLE_CLIENT_IDS=
# Clave de Sign in with Apple (.p8): canjea el código de autorización por el refresh token
# de Apple (para revocarlo al borrar la cuenta). Obligatoria en PROD si Apple está encendido.
# PEM en una línea con \n escapados.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Cifra en reposo el refresh token de Apple (AES-256-GCM, al menos 32 caracteres).
# Obligatoria con APPLE_PRIVATE_KEY. Cambiarla deja ilegibles los tokens guardados.
APPLE_TOKEN_ENCRYPTION_KEY=

# Precios de mercado y tipo de cambio. Todas opcionales: sin llave, el proveedor no entra.
# DataBursatil (BMV y SIC): https://databursatil.com
DATABURSATIL_TOKEN=
# EODHD (respaldo de BMV, SIC y EE. UU.; plan gratis: 20 llamadas al día): https://eodhd.com
EODHD_API_KEY=
# Twelve Data (EE. UU.; plan gratis: 8 por minuto, 800 al día): https://twelvedata.com
TWELVEDATA_API_KEY=
# Banxico SIE (tipo de cambio FIX): https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=
# Orden de proveedores por mercado; el primero es el preferido.
# MARKET_DATA_ROUTES=BMV=databursatil,eodhd;SIC=databursatil,eodhd;US=twelvedata,eodhd
# Días hábiles que se vuelven a pedir en cada corrida (los proveedores corrigen cierres).
# MARKET_DATA_REVISION_DAYS=10
# Yahoo (API no oficial), solo como último recurso.
# MARKET_DATA_ENABLE_YAHOO=false

# API Configuration
ENVIRONMENT=PROD
# Frontend origin allowed by CORS in DEV/TEST (exact scheme+host+port, no trailing slash)
FRONTEND_URL=http://localhost:3000

# Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lunance
DB_USER=luna
DB_PASSWORD=luna_root

# Redis (rate limits, sesiones revocadas y bloqueo del login por intentos fallidos)
# Fuera de Docker: redis://localhost:6379/0. En docker-compose, REDIS_URL se sobrescribe
# para apuntar al servicio `redis` con REDIS_PASSWORD.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CHANGE_ME
# Cabecera con la IP real del cliente detrás de un proxy. Vacío = IP de la conexión.
# Usa CF-Connecting-IP solo si el origen acepta tráfico únicamente desde Cloudflare.
CLIENT_IP_HEADER=

# AI Settings
AI_PROVIDER=provider# ollama/google-gla/anthropic
AI_MODEL_ID=model_id# gemini-3-flash-preview/kimi-k2.5:cloud/gemma4:31b-cloud
AI_API_KEY=CHANGE_ME
# BASE_URL informations
#Specific value for the Ollama provider (optional).
AI_BASE_URL=https://ollama.com/v1

# Logging Configuration
# LOG_PROVIDER options:
# - console: Console logging
# - grafana: Grafana Loki logging
# - file: File logging
# - hybrid: Hybrid console and Grafana Loki logging
LOG_PROVIDER=console
LOG_LEVEL=INFO
# Log format supported
# Text or Json
LOG_FORMAT=text

# Grafana Loki Configuration
# NOTE: This is only used if LOG_PROVIDER is set to "grafana" or "hybrid"
LOKI_URL=CHANGE_ME
LOKI_USERNAME=CHANGE_ME
LOKI_PASSWORD=CHANGE_ME
LOKI_APP_NAME=lunance
LOKI_ENV=development
