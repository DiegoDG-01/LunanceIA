# JWT Configuration
SECRET_KEY=CHANGE_ME
SECRET_KEY_REFRESH=CHANGE_ME
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh token cookie (httpOnly)
# COOKIE_SECURE must be False for local HTTP dev — browsers drop Secure
# cookies on non-HTTPS origins even on localhost. Use True in PROD/staging.
COOKIE_DOMAIN=
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
COOKIE_HTTPONLY=True

# BANXICO API TOKEN
BANXICO_TOKEN=CHANGE_ME

AUTH0_DOMAIN=CHANGE_ME
AUTH0_AUDIENCE=CHANGE_ME

# API Configuration
ENVIRONMENT=PROD
# Frontend origin allowed by CORS in DEV/TEST (exact scheme+host+port, no trailing slash)
FRONTEND_URL=http://localhost:3000

# Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lunance
DB_USER=luna
DB_PASSWORD=luna_root

# AI Settings
AI_PROVIDER=provider# ollama/google-gla/anthropic
AI_MODEL_ID=model_id# gemini-3-flash-preview/kimi-k2.5:cloud/gemma4:31b-cloud
AI_API_KEY=CHANGE_ME
# BASE_URL informations
#Specific value for the Ollama provider (optional).
AI_BASE_URL=https://ollama.com/v1

# Logging Configuration
# LOG_PROVIDER options:
# - console: Console logging
# - grafana: Grafana Loki logging
# - file: File logging
# - hybrid: Hybrid console and Grafana Loki logging
LOG_PROVIDER=console
LOG_LEVEL=INFO
# Log format supported
# Text or Json
LOG_FORMAT=text

# Grafana Loki Configuration
# NOTE: This is only used if LOG_PROVIDER is set to "grafana" or "hybrid"
LOKI_URL=CHANGE_ME
LOKI_USERNAME=CHANGE_ME
LOKI_PASSWORD=CHANGE_ME
LOKI_APP_NAME=lunance
LOKI_ENV=development
