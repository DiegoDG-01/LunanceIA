# Autenticación (sesiones por dispositivo)
# Genera las claves con:  uv run python scripts/generate_secrets.py >> .env
# Access token: JWT EdDSA (Ed25519). PEM en una línea con \n escapados.
JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----'
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----'
JWT_ISSUER=lunance
JWT_AUDIENCE=lunance-api
ACCESS_TOKEN_EXPIRE_MINUTES=10
# Deriva el sucesor de cada refresh token al rotarlo (mínimo 32 caracteres).
# Cambiarla obliga a todos los dispositivos a volver a iniciar sesión.
REFRESH_ROTATION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Repetir un refresh ya canjeado dentro de esta ventana no revoca la sesión.
REFRESH_REUSE_GRACE_SECONDS=30
# Duración de las sesiones (días): inactividad máxima y tope absoluto desde el login.
SESSION_WEB_IDLE_DAYS=1
SESSION_WEB_ABSOLUTE_DAYS=7
SESSION_MOBILE_IDLE_DAYS=30
SESSION_MOBILE_ABSOLUTE_DAYS=90

# Refresh token cookie (httpOnly)
# COOKIE_SECURE must be False for local HTTP dev — browsers drop Secure
# cookies on non-HTTPS origins even on localhost. Use True in PROD/staging.
COOKIE_DOMAIN=
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
COOKIE_HTTPONLY=True

# BANXICO API TOKEN
BANXICO_TOKEN=CHANGE_ME

# API Configuration
ENVIRONMENT=PROD
# Frontend origin allowed by CORS in DEV/TEST (exact scheme+host+port, no trailing slash)
FRONTEND_URL=http://localhost:3000

# Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lunance
DB_USER=luna
DB_PASSWORD=luna_root

# Redis (rate limits y sesiones revocadas)
# Fuera de Docker: redis://localhost:6379/0. En docker-compose, REDIS_URL se sobrescribe
# para apuntar al servicio `redis` con REDIS_PASSWORD.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CHANGE_ME
# Cabecera con la IP real del cliente detrás de un proxy. Vacío = IP de la conexión.
# Usa CF-Connecting-IP solo si el origen acepta tráfico únicamente desde Cloudflare.
CLIENT_IP_HEADER=

# AI Settings
AI_PROVIDER=provider# ollama/google-gla/anthropic
AI_MODEL_ID=model_id# gemini-3-flash-preview/kimi-k2.5:cloud/gemma4:31b-cloud
AI_API_KEY=CHANGE_ME
# BASE_URL informations
#Specific value for the Ollama provider (optional).
AI_BASE_URL=https://ollama.com/v1

# Logging Configuration
# LOG_PROVIDER options:
# - console: Console logging
# - grafana: Grafana Loki logging
# - file: File logging
# - hybrid: Hybrid console and Grafana Loki logging
LOG_PROVIDER=console
LOG_LEVEL=INFO
# Log format supported
# Text or Json
LOG_FORMAT=text

# Grafana Loki Configuration
# NOTE: This is only used if LOG_PROVIDER is set to "grafana" or "hybrid"
LOKI_URL=CHANGE_ME
LOKI_USERNAME=CHANGE_ME
LOKI_PASSWORD=CHANGE_ME
LOKI_APP_NAME=lunance
LOKI_ENV=development
